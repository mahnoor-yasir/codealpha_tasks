string trim(string s)
{
    while (!s.empty() && s[0] == ' ')
        s.erase(0, 1);

    while (!s.empty() && s[s.length() - 1] == ' ')
        s.erase(s.length() - 1, 1);

    return s;
}

string toLowerCase(string s)
{
    for (int i = 0; i < s.length(); i++)
    {
        if (s[i] >= 'A' && s[i] <= 'Z')
            s[i] = s[i] + 32;
    }
    return s;
}

